rules_version = '2';
// Paint Runner database rules. Publish in the Firebase console:
// Firestore Database -> Rules -> paste this whole file -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The game owner, who can open the stats page.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'filossof@gmail.com' && request.auth.token.email_verified == true;
    }

    // Public profiles + progress; the star ranking reads these, so anyone may read.
    match /pr_players/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0 && request.resource.data.totalStars <= 300;
    }

    // Emails stay private: only the owner (stats page) can read them.
    match /pr_private/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Leaderboards: one row per player per level. Public to read; each player writes only
    // their own row, with sane values.
    match /pr_levels/{level}/pr_scores/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bestTime is number && request.resource.data.bestTime >= 1
        && request.resource.data.bestStars is int
        && request.resource.data.bestStars >= 0 && request.resource.data.bestStars <= 3
        && (!('best3Time' in request.resource.data) || (request.resource.data.best3Time is number && request.resource.data.best3Time >= 1))
        && (!('fewestThrows' in request.resource.data) || (request.resource.data.fewestThrows is int && request.resource.data.fewestThrows >= 0));
    }

    // Play sessions (how long people actually play), for the stats page.
    match /pr_sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.seconds is int && request.resource.data.seconds >= 0;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.seconds is int && request.resource.data.seconds >= 0;
      allow read: if isAdmin();
    }

    // Every finished or abandoned attempt, for the stats page.
    match /pr_runs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
