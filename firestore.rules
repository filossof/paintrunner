rules_version = '2';
// Paint Runner database rules. Publish in the Firebase console:
// Firestore Database -> Rules -> paste this whole file -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with a Firebase account, guests (anonymous) included: enough for the stats logs.
    function signedIn() { return request.auth != null; }
    // Signed in with Google (not a guest): needed for profiles and leaderboards.
    // (A guest who signed in with Google keeps their account; their token then carries an email.)
    function member() {
      return signedIn() && (request.auth.token.firebase.sign_in_provider != 'anonymous' || 'email' in request.auth.token);
    }
    // A guest who picked a nickname: the name they're writing under is theirs (pr_names).
    function ownsName(name) {
      return signedIn() && name is string
        && exists(/databases/$(database)/documents/pr_names/$(name.lower()))
        && get(/databases/$(database)/documents/pr_names/$(name.lower())).data.uid == request.auth.uid;
    }
    // On the leaderboards: signed in with Google, or writing under your own nickname.
    function player() { return member() || ownsName(request.resource.data.name); }
    // The game owner, who can open the stats page.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'filossof@gmail.com' && request.auth.token.email_verified == true;
    }

    // Nicknames: one owner each, ignoring case (the document ID is the name in lowercase).
    // Taken names can't be taken over (no updates); you can let go of your own.
    match /pr_names/{key} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.lower() == key
        && key.matches('^[a-z0-9_]{3,16}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Public profiles + progress; the star ranking reads these, so anyone may read.
    match /pr_players/{uid} {
      allow read: if true;
      allow create, update: if player() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0 && request.resource.data.totalStars <= 300;
    }

    // Emails stay private: only the owner (stats page) can read them.
    match /pr_private/{uid} {
      allow read: if isAdmin();
      allow create, update: if member() && request.auth.uid == uid;
    }

    // Leaderboards: one row per player per level. Public to read; each player (Google or a
    // nickname) writes only their own row, with sane values.
    match /pr_levels/{level}/pr_scores/{uid} {
      allow read: if true;
      allow create, update: if player() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bestTime is number && request.resource.data.bestTime >= 1
        && request.resource.data.bestStars is int
        && request.resource.data.bestStars >= 0 && request.resource.data.bestStars <= 3
        && (!('best3Time' in request.resource.data) || (request.resource.data.best3Time is number && request.resource.data.best3Time >= 1))
        && (!('fewestThrows' in request.resource.data) || (request.resource.data.fewestThrows is int && request.resource.data.fewestThrows >= 0));
    }

    // Ghosts: each player's fastest recorded run of a level, which others race. Public to read.
    // Only your own, only once that time is on the leaderboard, and never faster than your best there.
    match /pr_levels/{level}/pr_ghosts/{uid} {
      allow read: if true;
      allow create, update: if player() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.data is string && request.resource.data.data.size() <= 250000
        && request.resource.data.time is number
        && request.resource.data.time >= get(/databases/$(database)/documents/pr_levels/$(level)/pr_scores/$(uid)).data.bestTime;
    }

    // The Daily Chase: one row per player per day, their best time. Public to read.
    match /pr_daily/{day}/pr_scores/{uid} {
      allow read: if true;
      allow create, update: if player() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.time is number && request.resource.data.time >= 1
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3;
    }

    // Play sessions (one per visit: how long people actually play), for the stats page. Guests too.
    match /pr_sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.seconds is int && request.resource.data.seconds >= 0;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.seconds is int && request.resource.data.seconds >= 0;
      allow read: if isAdmin();
    }

    // Every finished or abandoned attempt, for the stats page. Guests too.
    match /pr_runs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
